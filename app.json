{
  "expo": {
    "name": "Comandadigitalprint",
    "owner": "onlybeones-team",
    "slug": "matheus-sampaio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/chef-icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "./plugins/with-receipt-paper",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso as fotos para escolher a logo do restaurante.",
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.wooxonly.comandadigitalprint",
      "adaptiveIcon": {
        "backgroundColor": "#202322",
        "foregroundImage": "./assets/chef-foreground.png",
        "monochromeImage": "./assets/chef-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "239a9a61-a6d5-4c62-ad74-2a4316a06394"
      }
    }
  }
}
