{
  "name": "bistrohub-app-homologacao",
  "main": "web-worker.mjs",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "assets": { "directory": "../../web-dist", "binding": "WEB_ASSETS", "run_worker_first": true },
  "services": [{ "binding": "BACKEND", "service": "seabra-cardapio-homologacao" }]
}
